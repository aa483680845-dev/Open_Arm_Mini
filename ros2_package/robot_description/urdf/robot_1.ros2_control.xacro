<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">

        <ros2_control name="robot_1" type="system">
            <hardware>
               <!-- <plugin>mobile_base_hardware/MobileBaseHardwareInterface</plugin> -->
                <plugin>mujoco_ros2_control/MujocoSystemInterface</plugin>
                <param name="mujoco_model">$(find robot_description)/urdf/Mujoco_xml/robot_mujoco.xml</param>
                <!-- <plugin>mock_components/GenericSystem</plugin> -->
            </hardware>
            <!-- kp/kd: MIT位置模式增益，透传给 dm_control_mit -->
            <joint name="joint_1">
                <param name="kp">80.0</param>
                <param name="kd">10.0</param>
                <command_interface name="position"/>
                <command_interface name="velocity"/>
                <command_interface name="effort"/>
                <state_interface name="position"/>
                <state_interface name="velocity"/>
                <state_interface name="effort"/>
            </joint>
            <joint name="joint_2">
                <param name="kp">90.0</param>
                <param name="kd">15.0</param>
                <command_interface name="position"/>
                <command_interface name="velocity"/>
                <command_interface name="effort"/>
                <state_interface name="position"/>
                <state_interface name="velocity"/>
                <state_interface name="effort"/>
            </joint>
            <joint name="joint_3">
                <param name="kp">120.0</param>
                <param name="kd">20.0</param>
                <command_interface name="position"/>
                <command_interface name="velocity"/>
                <command_interface name="effort"/>
                <state_interface name="position"/>
                <state_interface name="velocity"/>
                <state_interface name="effort"/>
            </joint>
            <joint name="joint_4">
                <param name="kp">20.0</param>
                <param name="kd">1.0</param>
                <command_interface name="position"/>
                <command_interface name="velocity"/>
                <command_interface name="effort"/>
                <state_interface name="position"/>
                <state_interface name="velocity"/>
                <state_interface name="effort"/>
            </joint>
            <joint name="joint_5">
                <param name="kp">20.0</param>
                <param name="kd">1.0</param>
                <command_interface name="position"/>
                <command_interface name="velocity"/>
                <command_interface name="effort"/>
                <state_interface name="position"/>
                <state_interface name="velocity"/>
                <state_interface name="effort"/>
            </joint>
            <joint name="joint_6">
                <param name="kp">20.0</param>
                <param name="kd">1.0</param>
                <command_interface name="position"/>
                <command_interface name="velocity"/>
                <command_interface name="effort"/>
                <state_interface name="position"/>
                <state_interface name="velocity"/>
                <state_interface name="effort"/>
            </joint>
        </ros2_control>

</robot>
